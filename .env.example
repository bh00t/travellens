# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travellens
POSTGRES_USER=travellens
POSTGRES_PASSWORD=changeme_in_real_setup

# Kafka (Phase 2)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=booking-events

# S3 / MinIO (Phase 2)
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=travellens-data
S3_PREFIX_RAW=raw/
S3_PREFIX_REVIEWS=reviews/
S3_PREFIX_REFERENCE=reference/
S3_PREFIX_PROCESSED=processed/

# Ollama (Phase 4)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Application
DATA_DIR=./data
RESULTS_DIR=./query_results

# ── Airflow (Phase 6) ──────────────────────────────────────────────────────
# Airflow runs in its own container with its OWN metadata Postgres
# (airflow-postgres), kept deliberately separate from the warehouse Postgres.
# The container's SQLAlchemy<2.0 requirement is isolated from the project's
# SQLAlchemy 2.x pin — they never share a Python environment.

# Metadata DB credentials — used by the airflow-postgres service AND by
# the Airflow scheduler/webserver to connect to it. Internal-only: the
# airflow-postgres container is NOT exposed on the host.
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=changeme_in_real_setup

# Fernet key — encrypts Connection passwords stored in the metadata DB.
# If this is empty or changes between restarts, all stored Connection
# passwords become unreadable. Generate ONCE with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Replace the placeholder below with the generated value in your local .env.
AIRFLOW_FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Flask session signing key for the Airflow webserver UI. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=REPLACE_WITH_GENERATED_HEX_TOKEN

# Connection URIs — Airflow reads AIRFLOW_CONN_<conn_id> env vars at
# startup and auto-creates Connection objects. The Conn ID is derived
# from the env var suffix (lowercased). DAGs reference these by ID.
#
# IMPORTANT: hostnames here are Docker service names (postgres, minio),
# NOT localhost, because Airflow runs inside the same compose network.

# Warehouse Postgres — DAGs use Conn ID "travellens_warehouse" to read
# fact_bookings / write agg_daily_hotel_kpi / etc.
AIRFLOW_CONN_TRAVELLENS_WAREHOUSE=postgresql://travellens:changeme_in_real_setup@postgres:5432/travellens

# S3 / MinIO — DAGs use Conn ID "travellens_s3" to read or write Parquet
# files under the travellens-data bucket. The endpoint_url query param
# points the AWS provider at MinIO instead of real AWS. Special chars in
# the URI (the http:// in endpoint_url) MUST be URL-encoded.
AIRFLOW_CONN_TRAVELLENS_S3=aws://minioadmin:minioadmin@?endpoint_url=http%3A%2F%2Fminio%3A9000&region_name=us-east-1
