# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Environment
.env
.env.local

# Claude Code — per-developer permissions stay local; shared config is .claude/settings.json
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Session notes — local handoff scratchpad; not committed (owner decision)
docs/session-notes.md

# Calendar simulator clock — local machine state; rebuilt on first run
scripts/.sim_clock.json

# Data — do not commit large CSVs to git
data/*.csv
data/*.json
!data/.gitkeep

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
*.parquet
*.duckdb
query_results/

# OS
.DS_Store
Thumbs.db

# Flink legacy artifacts (kept locally for history, not shipped)
flink/
!flink/.gitkeep

# Test logs (regenerate on every run)
consumer_*.log
producer_*.log

# Quarantine sample dumps (if you mc cat locally)
*.quarantine.json